local SoundService = game:GetService("SoundService")
local M = { vol = 1, speed = 1 }
local music = new("Sound", { Name = "VisualsMusic", Volume = M.vol, PlaybackSpeed = M.speed }, SoundService)
local playToken = 0
local idBox, statusLabel

local function setStatus(text)
	if statusLabel then statusLabel.Text = text end
end

local function playMusic()
	local digits = string.match(idBox.Text, "%d+")
	if not digits then setStatus("Введи ID аудио (только цифры)"); return end
	playToken += 1
	local token = playToken
	music:Stop()
	music.SoundId = "rbxassetid://" .. digits
	music.Volume = M.vol
	music.PlaybackSpeed = M.speed
	music:Play()
	setStatus("Загрузка...")
	task.delay(4, function()
		if token ~= playToken then return end
		if music.IsLoaded then
			setStatus(music.IsPlaying and "Играет" or "Готово")
		else
			setStatus("Не загрузилось: неверный ID или нет доступа")
		end
	end)
end

local function stopMusic()
	playToken += 1
	music:Stop()
	setStatus("Остановлено")
end

