S.steps = { on = false, style = "Круги", color = BLUE, rainbow = false, size = 2, life = 1.2, trans = 0.3 }
local STEP_STYLES = { "Круги", "Искры", "Пламя" }
local STRIDE = 4
local stepDist, stepSide = 0, 1

local function spawnStep()
	local c = S.steps
	local feet = (hum.RigType == Enum.HumanoidRigType.R15) and (hum.HipHeight + hrp.Size.Y / 2) or 3
	local pos = hrp.Position - Vector3.new(0, feet - 0.05, 0) + hrp.CFrame.RightVector * (0.55 * stepSide)
	local col = colorOf(c)

	if c.style == "Круги" then
		local ring = new("Part", {
			Shape = Enum.PartType.Cylinder,
			Material = Enum.Material.Neon,
			Color = col,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Transparency = c.trans,
			Size = Vector3.new(0.1, c.size, c.size),
			CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		}, folder)
		TweenService:Create(ring, TweenInfo.new(c.life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(0.1, c.size * 1.6, c.size * 1.6),
			Transparency = 1,
		}):Play()
		Debris:AddItem(ring, c.life + 0.1)
		return
	end

	local spark = (c.style == "Искры")
	local anchor = new("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.5, 0.1, 0.5),
		CFrame = CFrame.new(pos),
	}, folder)
	local em = new("ParticleEmitter", {
		Enabled = false,
		Texture = spark and "rbxasset://textures/particles/sparkles_main.dds"
			or "rbxasset://textures/particles/fire_main.dds",
		Color = ColorSequence.new(col),
		LightEmission = 1,
		Lifetime = NumberRange.new(c.life * 0.5, c.life),
		Size = ns({ 0, c.size * (spark and 0.35 or 0.6) }, { 1, 0 }),
		Transparency = ns({ 0, c.trans }, { 1, 1 }),
		Speed = spark and NumberRange.new(4, 9) or NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(spark and 50 or 25, spark and 50 or 25),
		Acceleration = Vector3.new(0, spark and -12 or 5, 0),
		Rotation = NumberRange.new(0, 360),
	}, anchor)
	em:Emit(spark and 14 or 8)
	Debris:AddItem(anchor, c.life + 0.2)
end

RunService.Heartbeat:Connect(function(dt)
	local c = S.steps
	if not c.on or not hrp or not hum or hum.Health <= 0 then
		stepDist = 0
		return
	end
	if hum.FloorMaterial == Enum.Material.Air or hum.MoveDirection.Magnitude < 0.1 then
		return
	end
	local v = hrp.AssemblyLinearVelocity
	stepDist += Vector3.new(v.X, 0, v.Z).Magnitude * dt
	if stepDist >= STRIDE then
		stepDist -= STRIDE
		stepSide = -stepSide
		spawnStep()
	end
end)

