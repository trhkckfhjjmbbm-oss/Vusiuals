local FACE_PROPS = { Bk = "SkyboxBk", Dn = "SkyboxDn", Ft = "SkyboxFt", Lf = "SkyboxLf", Rt = "SkyboxRt", Up = "SkyboxUp" }
local LIGHT_PROPS = { "Brightness", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom", "ClockTime", "FogColor", "FogStart", "FogEnd", "ExposureCompensation" }

local skyObj = new("Sky", { Name = "VisSky" }, nil)
local atm = new("Atmosphere", { Name = "VisAtmosphere" }, nil)
local skyCC = new("ColorCorrectionEffect", { Name = "VisSkyColor", Enabled = false }, Lighting)
local skyBloom = new("BloomEffect", { Name = "VisSkyBloom", Enabled = false, Size = 30, Threshold = 0.9 }, Lighting)
local skyRays = new("SunRaysEffect", { Name = "VisSkyRays", Enabled = false, Spread = 0.7 }, Lighting)

local savedLighting = nil
local stashed = {}

local function pv(p, k) if p[k] ~= nil then return p[k] end return SKY_DEFAULT[k] end

local function snapshotSky()
	if savedLighting then return end
	savedLighting = {}
	for _, k in ipairs(LIGHT_PROPS) do savedLighting[k] = Lighting[k] end
	for _, ch in ipairs(Lighting:GetChildren()) do
		if (ch:IsA("Sky") or ch:IsA("Atmosphere")) and ch ~= skyObj and ch ~= atm then
			table.insert(stashed, ch); ch.Parent = nil
		end
	end
end

local function restoreSky()
	skyObj.Parent = nil; atm.Parent = nil
	skyCC.Enabled = false; skyCC.Brightness = 0
	skyBloom.Enabled = false; skyRays.Enabled = false
	if savedLighting then
		for k, v in pairs(savedLighting) do Lighting[k] = v end
		savedLighting = nil
	end
	for _, ch in ipairs(stashed) do ch.Parent = Lighting end
	table.clear(stashed)
end

local function applySky()
	local p = SKY_PRESETS[S.sky.preset]
	if not p then restoreSky(); return end
	snapshotSky()
	for key, prop in pairs(FACE_PROPS) do skyObj[prop] = (p.faces and p.faces[key]) or "" end
	skyObj.StarCount = pv(p, "stars"); skyObj.CelestialBodiesShown = (p.bodies ~= false)
	skyObj.SunAngularSize = p.sun or 21; skyObj.MoonAngularSize = p.moon or 11
	skyObj.Parent = Lighting
	if p.atm then for k, v in pairs(p.atm) do atm[k] = v end; atm.Parent = Lighting else atm.Parent = nil end
	Lighting.Brightness = pv(p, "bright"); Lighting.Ambient = pv(p, "ambient")
	Lighting.OutdoorAmbient = pv(p, "outdoor"); Lighting.ColorShift_Top = pv(p, "top")
	Lighting.ColorShift_Bottom = pv(p, "bottom"); Lighting.FogColor = pv(p, "fog")
	Lighting.FogStart = pv(p, "fogStart"); Lighting.FogEnd = pv(p, "fogEnd")
	Lighting.ClockTime = (pv(p, "time") + S.sky.shift) % 24
	Lighting.ExposureCompensation = S.sky.exposure
	skyCC.Enabled = true; skyCC.Brightness = 0
	skyCC.TintColor = pv(p, "tint"); skyCC.Saturation = pv(p, "sat"); skyCC.Contrast = pv(p, "contrast")
	skyBloom.Intensity = pv(p, "bloom"); skyBloom.Enabled = pv(p, "bloom") > 0
	skyRays.Intensity = pv(p, "rays"); skyRays.Enabled = pv(p, "rays") > 0
end

local nextFlash = 0
local function flash()
	skyCC.Brightness = 0.55
	TweenService:Create(skyCC, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0 }):Play()
end

