local cc = new("ColorCorrectionEffect", { Name = "VisColor", Enabled = false }, Lighting)

local function applyTrail()
	if not trail then return end
	local c = S.trail
	local st = TRAIL_STYLES[c.style]
	tA0.Position = Vector3.new(0, c.width / 2, 0)
	tA1.Position = Vector3.new(0, -c.width / 2, 0)
	trail.Lifetime = c.life
	trail.Transparency = st.trans
	trail.WidthScale = st.width
	trail.LightEmission = st.light or c.bright
	trail.Color = ColorSequence.new(colorOf(c))
	trail.Enabled = c.on
end

local function applyAura()
	if not emitter then return end
	local c = S.aura
	emitter.Texture = AURA_TEX[c.style]
	emitter.Rate = c.rate
	emitter.Speed = NumberRange.new(c.speed * 0.5, c.speed)
	emitter.SpreadAngle = Vector2.new(c.spread, c.spread)
	emitter.Size = ns({ 0, c.size }, { 1, 0 })
	emitter.Acceleration = Vector3.new(0, c.drift, 0)
	emitter.LightEmission = (c.style == "Smoke") and 0.2 or 1
	emitter.Color = ColorSequence.new(colorOf(c))
	emitter.Enabled = c.on
end

local function rebuildOrbs()
	for _, p in ipairs(orbs) do p:Destroy() end
	table.clear(orbs)
	local c = S.orbit
	if not c.on or not hrp then return end
	local col = colorOf(c)
	for _ = 1, c.count do
		local p = new("Part", { Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Size = Vector3.one * c.size, Color = col }, folder)
		local a0 = new("Attachment", { Position = Vector3.new(0, c.size / 2, 0) }, p)
		local a1 = new("Attachment", { Position = Vector3.new(0, -c.size / 2, 0) }, p)
		new("Trail", { Attachment0 = a0, Attachment1 = a1, Lifetime = 0.7, LightEmission = 1, FaceCamera = true, Enabled = c.tail, Color = ColorSequence.new(col), Transparency = ns({ 0, 0.1 }, { 1, 1 }), WidthScale = ns({ 0, 1 }, { 1, 0 }) }, p)
		table.insert(orbs, p)
	end
end

local function applyGlow()
	if not highlight then return end
	local c = S.glow
	local col = colorOf(c)
	highlight.Enabled = c.on
	highlight.FillColor = col
	highlight.OutlineColor = col
	highlight.FillTransparency = c.fill
	light.Enabled = c.on and c.light
	light.Color = col
	light.Range = c.range
	light.Brightness = c.power
end

local function applyColors()
	if S.trail.rainbow and trail then trail.Color = ColorSequence.new(colorOf(S.trail)) end
	if S.aura.rainbow and emitter then emitter.Color = ColorSequence.new(colorOf(S.aura)) end
	if S.glow.rainbow then applyGlow() end
	if S.orbit.rainbow then
		local col = colorOf(S.orbit)
		for _, p in ipairs(orbs) do
			p.Color = col
			local tr = p:FindFirstChildOfClass("Trail")
			if tr then tr.Color = ColorSequence.new(col) end
		end
	end
end

local worldApplied = false
local origClock, origFov
local function applyWorld()
	local w = S.world
	local cam = workspace.CurrentCamera
	if w.on then
		if not worldApplied then origClock, origFov = Lighting.ClockTime, cam.FieldOfView; worldApplied = true end
		bloom.Enabled = true
		cc.Enabled = true
		bloom.Intensity = w.bloom
		cc.Saturation = w.sat
		cc.Contrast = w.contrast
		Lighting.ClockTime = w.time
		cam.FieldOfView = w.fov
	elseif worldApplied then
		bloom.Enabled = false
		cc.Enabled = false
		Lighting.ClockTime = origClock
		cam.FieldOfView = origFov
		worldApplied = false
	end
end

local function burst()
	local b = S.burst
	if not b.on or not hrp or not hum then return end
	local feetOffset = (hum.RigType == Enum.HumanoidRigType.R15) and (hum.HipHeight + hrp.Size.Y / 2) or 3
	local ring = new("Part", { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = colorOf(b), Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Size = Vector3.new(0.2, 2, 2), Transparency = 0.15, CFrame = CFrame.new(hrp.Position - Vector3.new(0, feetOffset, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, folder)
	TweenService:Create(ring, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.2, b.size, b.size), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.8)
end

local function onCharacter(c)
	hrp = c:WaitForChild("HumanoidRootPart")
	hum = c:WaitForChild("Humanoid")
	tA0 = new("Attachment", { Name = "VisA0" }, hrp)
	tA1 = new("Attachment", { Name = "VisA1" }, hrp)
	trail = new("Trail", { Attachment0 = tA0, Attachment1 = tA1, FaceCamera = true, Enabled = false }, hrp)
	emitter = new("ParticleEmitter", { Enabled = false, Lifetime = NumberRange.new(0.8, 1.6), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-60, 60), Transparency = ns({ 0, 0.2 }, { 1, 1 }) }, hrp)
	highlight = new("Highlight", { Adornee = c, Enabled = false, DepthMode = Enum.HighlightDepthMode.Occluded, OutlineTransparency = 0 }, c)
	light = new("PointLight", { Enabled = false, Shadows = false }, hrp)
	hum.Jumping:Connect(function(active) if active then burst() end end)
	applyTrail()
	applyAura()
	applyGlow()
	rebuildOrbs()
end

