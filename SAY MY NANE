local function toggle(page, text, get, set)
	local r = row(page, 34)
	rowLabel(r, text)
	local pill = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(38, 20), BackgroundColor3 = C.bg }, r)
	round(pill, 10)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.text }, pill)
	round(knob, 7)
	local function paint(animate)
		local on = get()
		local info = TweenInfo.new(animate and 0.12 or 0)
		TweenService:Create(pill, info, { BackgroundColor3 = on and C.accent or C.bg }):Play()
		TweenService:Create(knob, info, { Position = UDim2.new(0, on and 21 or 3, 0.5, 0) }):Play()
	end
	paint(false)
	local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, r)
	hit.Activated:Connect(function() set(not get()); paint(true) end)
end

local function slider(page, text, min, max, step, fmt, get, set)
	local r = row(page, 48)
	rowLabel(r, text)
	local isInt = string.find(fmt, "%%d") ~= nil
	local val = new("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.fromOffset(70, 30), BackgroundTransparency = 1, TextColor3 = C.dim, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right }, r)
	local bar = new("Frame", { Position = UDim2.new(0, 12, 0, 34), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = C.bg }, r)
	round(bar, 3)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.accent }, bar)
	round(fill, 3)
	local function paint()
		local v = get()
		fill.Size = UDim2.fromScale(math.clamp((v - min) / (max - min), 0, 1), 1)
		val.Text = string.format(fmt, isInt and math.floor(v + 0.5) or v)
	end
	paint()
	local function fromX(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor((min + a * (max - min)) / step + 0.5) * step
		set(math.clamp(v, min, max)); paint()
	end
	local hit = new("TextButton", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "" }, r)
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			lockedPage = page; page.ScrollingEnabled = false
			dragFn = function(pos) fromX(pos.X) end
			fromX(input.Position.X)
		end
	end)
end

local function chooser(page, text, options, get, set)
	local r = row(page, 34)
	rowLabel(r, text)
	local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(110, 24), BackgroundColor3 = C.bg, TextColor3 = C.accent, Font = Enum.Font.GothamMedium, TextSize = 13 }, r)
	round(b, 6)
	local function paint() b.Text = get() end
	paint()
	b.Activated:Connect(function()
		local i = table.find(options, get()) or 1
		set(options[i % #options + 1]); paint()
	end)
end

local function colorRow(page, cfg, onChange)
	local r = row(page, 58)
	rowLabel(r, "Цвет")
	local holder = new("Frame", { Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -24, 0, 22), BackgroundTransparency = 1 }, r)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, holder)
	local rainbowIndex = #PALETTE + 1
	local strokes = {}
	local function paint()
		for i, s in ipairs(strokes) do
			local selected
			if i == rainbowIndex then selected = cfg.rainbow else selected = (not cfg.rainbow) and cfg.color == PALETTE[i] end
			s.Transparency = selected and 0 or 1
		end
	end
	for i = 1, rainbowIndex do
		local sw = new("TextButton", { Size = UDim2.fromOffset(22, 22), Text = "", BackgroundColor3 = PALETTE[i] or Color3.new(1, 1, 1), AutoButtonColor = false }, holder)
		round(sw, 11)
		if i == rainbowIndex then
			new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(100, 255, 150)), ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 160, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 200)) }) }, sw)
		end
		strokes[i] = stroke(sw, Color3.new(1, 1, 1), 2, 1)
		sw.Activated:Connect(function()
			if i == rainbowIndex then
				cfg.rainbow = true
			else
				cfg.rainbow = false
				cfg.color = PALETTE[i]
			end
			paint()
			onChange()
		end)
	end
	paint()
end

