local function colorOf(cfg)
	if cfg.rainbow then return Color3.fromHSV(hue, 0.65, 1) end
	return cfg.color
end

local TRAIL_STYLES = {
	Glow = { trans = ns({ 0, 0.3 }, { 1, 1 }), width = ns({ 0, 1 }, { 1, 0 }) },
	Neon = { trans = ns({ 0, 0 }, { 0.8, 0.3 }, { 1, 1 }), width = ns({ 0, 1 }, { 1, 0.7 }), light = 1 },
	Smoke = { trans = ns({ 0, 0.5 }, { 1, 1 }), width = ns({ 0, 0.6 }, { 1, 2 }), light = 0 },
}
local TRAIL_ORDER = { "Glow", "Neon", "Smoke" }
local AURA_TEX = { Sparks = "rbxasset://textures/particles/sparkles_main.dds", Smoke = "rbxasset://textures/particles/smoke_main.dds", Fire = "rbxasset://textures/particles/fire_main.dds" }
local AURA_ORDER = { "Sparks", "Smoke", "Fire" }

